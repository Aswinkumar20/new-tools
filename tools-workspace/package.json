  "license": "MIT",
  "scripts": {
    "start": "nx serve tools-site",
    "serve": "nx serve tools-site",
    "start:ui": "nx serve tools-site",
    "start:api": "cd services/tool-api && mvn spring-boot:run",
    "start:pdf-api": "npm run start:api",
    "start:all": "npx concurrently -k \"npm run start:ui\" \"npm run start:api\"",
    "compose:api": "docker compose -f infra/compose/docker-compose.yml up --build tool-api",
    "compose:pdf-api": "npm run compose:api",
    "build": "nx run tools-site:build-prod",
    "build:ssg": "nx run tools-site:build-prod",
    "build:api": "cd services/tool-api && mvn -DskipTests package",
    "build:pdf-api": "npm run build:api",
    "serve:ssg": "nx run tools-site:serve-ssg",
    "test": "nx run-many -t test",
    "e2e": "nx run tools-site-e2e:e2e",
    "e2e:smoke": "nx run tools-site-e2e:e2e -- --grep @smoke --project=chromium",
    "e2e:deep": "bash apps/tools-site-e2e/scripts/run-deep-all.sh",
    "e2e:deep:report": "bash apps/tools-site-e2e/scripts/run-deep-report.sh",
    "e2e:tool": "bash apps/tools-site-e2e/scripts/run-tool-test.sh",
    "e2e:tool:report": "bash apps/tools-site-e2e/scripts/run-tool-test-report.sh",
    "e2e:category": "bash apps/tools-site-e2e/scripts/run-category-test.sh",
    "e2e:gen-commands": "node apps/tools-site-e2e/scripts/generate-tool-test-commands.js"
  },
