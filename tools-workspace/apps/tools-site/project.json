{
  "name": "tools-site",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/tools-site/src",
  "tags": [],
  "targets": {
    "generate-sitemap": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/tools-site/scripts/generate-sitemap.js",
        "description": "Generate sitemap.xml from application routes"
      }
    },
    "build": {
      "executor": "@angular-devkit/build-angular:browser",
      "outputs": ["{options.outputPath}"],
      "dependsOn": ["generate-sitemap"],
      "options": {
        "outputPath": "dist/apps/tools-site",
        "index": "apps/tools-site/src/index.html",
        "main": "apps/tools-site/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/tools-site/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/tools-site/assets",
            "output": "assets"
          },
          {
            "glob": "**/*",
            "input": "node_modules/monaco-editor",
            "output": "assets/monaco-editor"
          },
          {
            "glob": "sitemap.xml",
            "input": "apps/tools-site/public",
            "output": "."
          },
          {
            "glob": "robots.txt",
            "input": "apps/tools-site/public",
            "output": "."
          }
        ],
        "styles": ["apps/tools-site/src/styles.scss"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "100mb",
              "maximumError": "100mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "80mb",
              "maximumError": "80mb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": false,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "development"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "tools-site:build:production"
        },
        "development": {
          "buildTarget": "tools-site:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "tools-site:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/tools-site/jest.config.ts",
        "tsConfig": "apps/tools-site/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "tools-site:build",
        "port": 4200,
        "spa": true
      }
    },
    "server": {
      "dependsOn": ["build"],
      "executor": "@angular-devkit/build-angular:server",
      "options": {
        "outputPath": "dist/apps/tools-site/server",
        "main": "apps/tools-site/src/server.ts",
        "tsConfig": "apps/tools-site/tsconfig.server.json",
        "inlineStyleLanguage": "scss"
      },
      "configurations": {
        "production": {
          "outputHashing": "media"
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "sourceMap": true,
          "extractLicenses": false,
          "vendorChunk": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve-ssr": {
      "continuous": true,
      "executor": "@angular-devkit/build-angular:ssr-dev-server",
      "configurations": {
        "development": {
          "browserTarget": "tools-site:build:development",
          "serverTarget": "tools-site:server:development"
        },
        "production": {
          "browserTarget": "tools-site:build:production",
          "serverTarget": "tools-site:server:production"
        }
      },
      "defaultConfiguration": "development"
    },
    "prerender": {
      "executor": "@angular-devkit/build-angular:prerender",
      "options": {
        "routes": ["/"]
      },
      "configurations": {
        "development": {
          "browserTarget": "tools-site:build:development",
          "serverTarget": "tools-site:server:development"
        },
        "production": {
          "browserTarget": "tools-site:build:production",
          "serverTarget": "tools-site:server:production"
        }
      },
      "defaultConfiguration": "production"
    }
  }
}
