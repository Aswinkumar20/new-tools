{
  "name": "testing-tools",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/testing-tools/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": [
    "type:feature",
    "scope:testing-tools"
  ],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "libs/testing-tools/jest.config.ts",
        "tsConfig": "libs/testing-tools/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
