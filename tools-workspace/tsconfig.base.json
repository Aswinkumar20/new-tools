{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "incremental": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@tools-workspace/features-home": ["libs/features-home/src/index.ts"],
      "@tools-workspace/text-utilities": ["libs/text-utilities/src/index.ts"],
      "@tools-workspace/file-viewers": ["libs/file-viewers/src/index.ts"],
      "@tools-workspace/data-converters": ["libs/data-converters/src/index.ts"],
      "@tools-workspace/math-date-utils": ["libs/math-date-utils/src/index.ts"],
      "@tools-workspace/pdf-tools": ["libs/pdf-tools/src/index.ts"],
      "@tools-workspace/image-color-tools": ["libs/image-color-tools/src/index.ts"],
      "@tools-workspace/code-file-tools": ["libs/code-file-tools/src/index.ts"],
      "@tools-workspace/dev-design-tools": ["libs/dev-design-tools/src/index.ts"],
      "@tools-workspace/testing-tools": ["libs/testing-tools/src/index.ts"],
      "@tools-workspace/security-tools": ["libs/security-tools/src/index.ts"],
      "@tools-workspace/media-tools": ["libs/media-tools/src/index.ts"],
      "@tools-workspace/browser-utils": ["libs/browser-utils/src/index.ts"],
      "@tools-workspace/fun-tools": ["libs/fun-tools/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
